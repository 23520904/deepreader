DOCKER_STORAGE_ACCESS_KEY=
DOCKER_STORAGE_SECRET_KEY=
DOCKER_STORAGE_BUCKET=deepreader-documents
STORAGE_PATH_STYLE=true
DOCKER_STORAGE_LOCAL_DIRECTORY=/app/data/documents

APP_ADMIN_SEED_ENABLED=true
APP_ADMIN_EMAIL=admin@deepreader.local
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-this-password

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
