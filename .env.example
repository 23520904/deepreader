EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5

DOCKER_DATABASE_URL=jdbc:postgresql://postgres:5432/deepreader
DOCKER_DATABASE_USERNAME=deepreader
DOCKER_DATABASE_PASSWORD=deepreader
WEB_MODULE_FLYWAY_ENABLED=true
WEB_MODULE_FLYWAY_BASELINE_VERSION=0
AI_SERVICE_FLYWAY_BASELINE_VERSION=0
