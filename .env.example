DOCKER_RELATIONAL_DATABASE_USERNAME=deepreader
DOCKER_RELATIONAL_DATABASE_PASSWORD=deepreader
DOCKER_MONGODB_URI=mongodb://mongodb:27017/deepreader

DOCKER_REDIS_HOST=redis
DOCKER_REDIS_PORT=6379
DOCKER_REDIS_USERNAME=
DOCKER_REDIS_PASSWORD=
DOCKER_REDIS_SSL_ENABLED=false

DOCKER_QDRANT_HOST=qdrant
DOCKER_QDRANT_GRPC_PORT=6334
DOCKER_QDRANT_API_KEY=
DOCKER_QDRANT_USE_TLS=false
HAYSTACK_QDRANT_URL=http://qdrant:6333
HAYSTACK_QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=document_chunks
QDRANT_TIMEOUT_SECONDS=10

SPRING_CODEC_MAX_IN_MEMORY_SIZE=32MB
INGESTION_MAX_FILE_SIZE_BYTES=26214400
INGESTION_MAX_RETRIES=3
