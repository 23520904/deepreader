GEMINI_API_KEY=
GROQ_API_KEY=
JWT_SECRET=replace-with-strong-random-secret
JWT_TTL_SECONDS=86400
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
INGESTION_MAX_FILE_SIZE_BYTES=26214400
INGESTION_MAX_RETRIES=3
GUARDRAILS_MAX_LLM_REQUESTS_PER_DAY=500
GUARDRAILS_MAX_UPLOADS_PER_DAY=100
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=5

HAYSTACK_BASE_URL=http://haystack-service:8000
HAYSTACK_PORT=8000

QDRANT_URL=https://your-qdrant-endpoint:6333
QDRANT_HOST=your-qdrant-endpoint
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_USE_TLS=true
QDRANT_COLLECTION_PREFIX=document_chunks
QDRANT_TIMEOUT_SECONDS=10

DATABASE_URL=jdbc:postgresql://your-supabase-host:6543/postgres?sslmode=require&prepareThreshold=0&preparedStatementCacheQueries=0
DATABASE_USERNAME=
DATABASE_PASSWORD=
RELATIONAL_DATABASE_URL=${DATABASE_URL}
RELATIONAL_DATABASE_USERNAME=${DATABASE_USERNAME}
RELATIONAL_DATABASE_PASSWORD=${DATABASE_PASSWORD}

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
DEEPREADER_DATA_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?appName=<app>

REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL_ENABLED=true

KAFKA_BOOTSTRAP_SERVERS=deepreader-kafka-gm-11eb.g.aivencloud.com:28732
KAFKA_SECURITY_PROTOCOL=SSL
KAFKA_SSL_KEY_PATH=/etc/aiven/service.key
KAFKA_SSL_CERTIFICATE_CHAIN_PATH=/etc/aiven/service.cert
KAFKA_SSL_CA_CERT_PATH=/etc/aiven/ca.pem
KAFKA_SSL_KEYSTORE_LOCATION=/etc/aiven/client-keystore.pem
BOOK_EVENTS_TOPIC=deepreader.book.events
BOOK_EVENTS_DLQ_TOPIC=deepreader.book.events.dlq
KAFKA_CAMEL_ROUTE_ENABLED=true

STORAGE_ENABLED=true
STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
STORAGE_REGION=us-east-005
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=deepreader
STORAGE_PATH_STYLE=true

AI_SERVICE_PORT=8080
DATA_SERVICE_PORT=8081
BUSINESS_SERVICE_PORT=8082
WEB_MODULE_PORT=8083
AI_SERVICE_HOST_PORT=18080
DATA_SERVICE_HOST_PORT=18081
BUSINESS_SERVICE_HOST_PORT=18082
WEB_MODULE_HOST_PORT=8083

# Docker backend overrides.
# web-module and ai-service use DATABASE_URL above when DOCKER_DATABASE_URL is unset.
# Keep/set DOCKER_DATABASE_URL to the local postgres URL below when you intentionally
# want Docker auth/index tables to be separate from Supabase.
POSTGRES_PORT=5432
POSTGRES_DB=deepreader
POSTGRES_USER=deepreader
POSTGRES_PASSWORD=deepreader
MONGODB_PORT=27017
REDIS_HOST_PORT=6379
DOCKER_DATABASE_URL=jdbc:postgresql://postgres:5432/deepreader
DOCKER_DATABASE_USERNAME=deepreader
DOCKER_DATABASE_PASSWORD=deepreader
DOCKER_RELATIONAL_DATABASE_URL=jdbc:postgresql://postgres:5432/deepreader
DOCKER_RELATIONAL_DATABASE_USERNAME=deepreader
DOCKER_RELATIONAL_DATABASE_PASSWORD=deepreader
DOCKER_MONGODB_URI=mongodb://mongodb:27017/deepreader
DOCKER_REDIS_HOST=redis
DOCKER_REDIS_PORT=6379
DOCKER_REDIS_SSL_ENABLED=false
DOCKER_QDRANT_HOST=qdrant
DOCKER_QDRANT_GRPC_PORT=6334
DOCKER_QDRANT_USE_TLS=false
DOCKER_STORAGE_ENABLED=false
DOCKER_KAFKA_CAMEL_ROUTE_ENABLED=false
DOCKER_KAFKA_PUBLISHER_ENABLED=false
