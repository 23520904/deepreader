# =============================================================================
# DeepReader — Environment Variables Example
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.
# =============================================================================


# =============================================================================
# FRONTEND (Next.js)
# =============================================================================

NEXT_PUBLIC_API_BASE_URL=http://localhost:8083


# =============================================================================
# WEB MODULE  (Spring Boot — port 8083, public-facing gateway)
# =============================================================================

SERVER_PORT=8083
BUSINESS_SERVICE_BASE_URL=http://localhost:8082
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_TTL_SECONDS=86400

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8083/api/v1/auth/oauth2/callback/google

# SMTP (email OTP / forgot password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=DeepReader

# Email verification
EMAIL_VERIFICATION_OTP_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10

# Database (PostgreSQL — shared with ai-service)
DATABASE_URL=jdbc:postgresql://localhost:5432/deepreader
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-db-password
DB_MAX_POOL_SIZE=2
DB_MIN_IDLE=0

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_SSL_ENABLED=false

SPRING_CODEC_MAX_IN_MEMORY_SIZE=32MB


# =============================================================================
# BUSINESS SERVICE  (Spring Boot — port 8082, internal)
# =============================================================================

BUSINESS_SERVICE_PORT=8082
AI_SERVICE_BASE_URL=http://localhost:8080
DATA_SERVICE_BASE_URL=http://localhost:8084

# Kafka (optional — disable for local dev)
KAFKA_PUBLISHER_ENABLED=false
KAFKA_CAMEL_ROUTE_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=deepreader-group
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SSL_CA_CERT_PATH=
KAFKA_SSL_KEYSTORE_LOCATION=
BOOK_EVENTS_TOPIC=book-events
BOOK_EVENTS_DLQ_TOPIC=book-events-dlq

# SPRING_CODEC_MAX_IN_MEMORY_SIZE=32MB


# =============================================================================
# AI SERVICE  (Spring WebFlux — port 8080, internal)
# =============================================================================

# Groq LLM
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# Gemini (embedding + generation)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_GENERATION_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_BATCH_SIZE=50
GEMINI_EMBEDDING_BATCH_DELAY_MS=32000
GEMINI_EMBEDDING_MAX_RETRIES=5
GEMINI_EMBEDDING_RETRY_DELAY_MS=15000

# Qdrant vector store
QDRANT_HOST=your-qdrant-host.cloud.qdrant.io
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_USE_TLS=true
QDRANT_COLLECTION_PREFIX=document_chunks
QDRANT_TIMEOUT_SECONDS=10

# Haystack (Python search service)
HAYSTACK_BASE_URL=http://localhost:8000

# Database (PostgreSQL — same instance as web-module)
# DATABASE_URL=jdbc:postgresql://localhost:5432/deepreader
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=your-db-password

# Redis (same instance as web-module)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=default
# REDIS_PASSWORD=your-redis-password
# REDIS_SSL_ENABLED=false

# Document ingestion
INGESTION_MAX_FILE_SIZE_BYTES=26214400
INGESTION_CHUNK_SIZE=1500
INGESTION_CHUNK_OVERLAP=200
INGESTION_MAX_RETRIES=3

# PDF vision analysis
PDF_VISION_MAX_IMAGES=16
PDF_VISION_MAX_TEXT_CHARS=100000
PDF_VISION_MIN_IMAGE_SIDE_PX=32
PDF_VISION_MAX_IMAGE_BYTES=4194304
PDF_VISION_FALLBACK_RENDER_PAGES=true
PDF_VISION_MAX_PAGES_TO_RENDER=8
PDF_VISION_RENDER_DPI=100

# Guardrails
GUARDRAILS_MAX_LLM_REQUESTS_PER_DAY=500
GUARDRAILS_MAX_UPLOADS_PER_DAY=100

# Background worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=5

# Data retention (days)
RETENTION_AUDIT_DAYS=30
RETENTION_DEAD_LETTER_DAYS=30
RETENTION_SESSION_DAYS=30
RETENTION_USAGE_DAYS=90

# File storage (set STORAGE_ENABLED=false to use local disk instead of S3/MinIO)
STORAGE_ENABLED=false
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=deepreader-documents
STORAGE_PATH_STYLE=true
STORAGE_LOCAL_DIRECTORY=data/documents

# SPRING_CODEC_MAX_IN_MEMORY_SIZE=32MB


# =============================================================================
# DATA SERVICE  (Spring Boot — port 8084, internal)
# =============================================================================

DATA_SERVICE_PORT=8084

# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/deepreader

# PostgreSQL (separate pool for data-service)
RELATIONAL_DATABASE_URL=jdbc:postgresql://localhost:5432/deepreader
RELATIONAL_DATABASE_USERNAME=postgres
RELATIONAL_DATABASE_PASSWORD=your-db-password
RELATIONAL_DB_MAX_POOL_SIZE=2
# DB_MIN_IDLE=0
